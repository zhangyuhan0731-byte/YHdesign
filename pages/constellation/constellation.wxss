/* pages/constellation/constellation.wxss */
.page { padding: 28rpx 24rpx 60rpx; }

.tool-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 34rpx 32rpx;
  margin-bottom: 24rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #282345, #7866d6);
  color: #fff;
  box-shadow: 0 18rpx 42rpx rgba(120, 102, 214, 0.22);
}
.tool-kicker {
  font-size: 20rpx;
  color: rgba(255,255,255,0.66);
  font-weight: 800;
}
.tool-title {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.16;
  margin-top: 6rpx;
}
.tool-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.76);
  margin-top: 10rpx;
}
.head-mark {
  width: 92rpx;
  height: 92rpx;
  border-radius: 32rpx;
  background: rgba(255,255,255,0.16);
  border: 2rpx solid rgba(255,255,255,0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 800;
}

.pickers {
  display: flex;
  align-items: stretch;
  gap: 14rpx;
  margin-bottom: 24rpx;
}
.picker-card.card {
  background: linear-gradient(180deg, #ffffff 0%, #f3f0ff 100%);
  padding: 30rpx 18rpx;
}
.picker-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.avatar {
  width: 136rpx;
  height: 136rpx;
  border-radius: 42rpx;
  background:
    radial-gradient(circle at 30% 24%, rgba(255,255,255,0.36), rgba(255,255,255,0) 32%),
    linear-gradient(150deg, #a698ff, #7866d6);
  color: #fff;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 32rpx rgba(120, 102, 214, 0.26);
  margin-bottom: 16rpx;
  border: 6rpx solid rgba(255,255,255,0.86);
}
.who {
  font-size: 23rpx;
  color: var(--muted);
  background: #f3f0ff;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  margin-bottom: 12rpx;
}
.pick-val {
  font-size: 26rpx;
  color: #7866d6;
  font-weight: 800;
  padding: 8rpx 0;
}
.manual {
  margin-top: 14rpx;
}
.manual-val {
  display: inline-block;
  font-size: 23rpx;
  color: var(--primary);
  background: var(--primary-tint);
  border: 2rpx solid #cde8f6;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
}
.manual-val:active { background: #dceffa; }
.vs-badge {
  align-self: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #202532;
  border: 4rpx solid #fff;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(32, 37, 50, 0.18);
}

.result {
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #ffffff, #f8f5ff);
  border: 1rpx solid rgba(120, 102, 214, 0.12);
}
.score-ring {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: conic-gradient(var(--c) calc(var(--p) * 1%), #eef3f7 0);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 10rpx 26rpx rgba(58, 155, 214, 0.18);
}
.score-ring-inner {
  width: 142rpx;
  height: 142rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.score {
  font-size: 64rpx;
  font-weight: 800;
  color: var(--ink);
  line-height: 1;
}
.score-unit { font-size: 22rpx; color: var(--muted); margin-top: 4rpx; }

.meta { flex: 1; padding-left: 28rpx; }
.level {
  display: inline-block;
  font-size: 27rpx;
  font-weight: 700;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  color: #fff;
}
.relation { font-size: 26rpx; color: var(--ink); margin-top: 16rpx; }
.elems { margin-top: 12rpx; font-size: 24rpx; color: var(--muted); }
.elem {
  display: inline-block;
  padding: 4rpx 18rpx;
  background: #f3f0ff;
  border-radius: 999rpx;
  color: #7866d6;
}
.plus { margin: 0 10rpx; }

.comment {
  font-size: 28rpx;
  color: var(--ink-2);
  line-height: 1.8;
}
.foot { margin-top: 24rpx; }
