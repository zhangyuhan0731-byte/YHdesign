/* pages/ledger-balance/ledger-balance.wxss */
.page { padding: 28rpx 24rpx 60rpx; }

/* ---------- 头部 ---------- */
.bal-head {
  padding: 40rpx 32rpx 36rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #1e3a5f, #2d7dd2);
  color: #fff;
  box-shadow: 0 18rpx 42rpx rgba(45, 125, 210, 0.24);
}
.bal-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
  font-weight: 700;
}
.bal-amount {
  margin-top: 8rpx;
  font-size: 64rpx;
  font-weight: 800;
  line-height: 1.15;
  word-break: break-all;
}
.bal-amount.neg { color: #ffd2c9; }
.bal-today {
  display: inline-block;
  margin-top: 14rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.14);
}
.bal-today.up { color: #9df0c5; }
.bal-today.down { color: #ffc4ba; }
.bal-title {
  font-size: 40rpx;
  font-weight: 800;
}
.bal-desc {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.78);
}
.bal-btns {
  display: flex;
  gap: 18rpx;
  margin-top: 34rpx;
}
.bal-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1;
}
.bal-btn.main {
  background: #fff;
  color: #2d7dd2;
  box-shadow: 0 10rpx 24rpx rgba(15, 40, 70, 0.22);
}
.bal-btn.main:active { transform: scale(0.97); }
.bal-btn.ghost {
  flex: 0 0 auto;
  padding: 0 34rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  color: rgba(255, 255, 255, 0.85);
}
.bal-btn.ghost:active { background: rgba(255, 255, 255, 0.22); }

/* ---------- 明细流水 ---------- */
.flow-card { margin-top: 24rpx; }
.flow-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}
.flow-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink);
}
.flow-note {
  font-size: 22rpx;
  color: var(--muted);
}
.flow-list { margin-top: 8rpx; }
.flow-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--hairline);
}
.flow-item:last-child { border-bottom: none; }
.flow-item.adjust .flow-avatar {
  border: 2rpx dashed #9cc8f5;
  background: #f7fbff !important;
}
.flow-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 25rpx;
  font-weight: 800;
}
.flow-main {
  flex: 1;
  min-width: 0;
}
.flow-line1,
.flow-line2 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}
.flow-line2 { margin-top: 8rpx; }
.flow-name {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.flow-amount {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 800;
}
.flow-amount.income { color: #25a974; }
.flow-amount.expense { color: #e66a7a; }
.flow-amount.adjust { color: var(--primary); font-size: 25rpx; }
.flow-sub {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: var(--muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.flow-after {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--ink-2);
  font-weight: 700;
}

.load-more {
  padding: 26rpx 0 6rpx;
  text-align: center;
  font-size: 23rpx;
  color: var(--muted);
}
.load-done {
  padding: 26rpx 0 6rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b6c7d4;
}

/* ---------- 校准弹层 ---------- */
.adjust-sheet {
  z-index: 61;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
}
.adjust-tip {
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.7;
  padding: 0 4rpx;
}
.adjust-input-card {
  display: flex;
  align-items: center;
  height: 108rpx;
  margin-top: 22rpx;
  padding: 0 26rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #edf5ff, #ffffff);
  border: 2rpx solid rgba(45, 125, 210, 0.10);
}
.adjust-currency {
  font-size: 36rpx;
  color: var(--primary);
  font-weight: 800;
  margin-right: 14rpx;
}
.adjust-input {
  flex: 1;
  height: 100%;
  font-size: 44rpx;
  font-weight: 800;
  color: var(--ink);
}
.adjust-btns {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}
.adjust-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
}
.adjust-btn.cancel {
  background: #f4f0e8;
  color: var(--ink-2);
}
.adjust-btn.cancel:active { background: #eae4d8; }
.adjust-btn.confirm {
  background: linear-gradient(135deg, #2d7dd2, #25a974);
  color: #fff;
  box-shadow: 0 10rpx 22rpx rgba(45, 125, 210, 0.22);
}
.adjust-btn.confirm:active { transform: scale(0.97); }

/* ---------- 未开启引导 ---------- */
.intro-card { margin-top: 24rpx; }
.intro-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--hairline);
}
.intro-item.last { border-bottom: none; padding-bottom: 8rpx; }
.intro-item:first-child { padding-top: 28rpx; }
.intro-ic {
  width: 64rpx;
  height: 64rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--primary-tint);
  color: var(--primary);
  font-size: 30rpx;
  font-weight: 800;
  flex-shrink: 0;
}
.intro-text { flex: 1; min-width: 0; }
.intro-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--ink);
}
.intro-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--muted);
  line-height: 1.6;
}
