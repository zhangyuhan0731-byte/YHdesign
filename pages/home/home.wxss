/* pages/home/home.wxss */
.page { padding: 28rpx 24rpx 60rpx; }

.hero {
  position: relative;
  overflow: hidden;
  min-height: 300rpx;
  padding: 42rpx 34rpx;
  margin-bottom: 30rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #202532 0%, #2d425f 48%, #2d7dd2 100%);
  box-shadow: 0 22rpx 54rpx rgba(32, 37, 50, 0.22);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.hero::before {
  content: '';
  position: absolute;
  left: 34rpx;
  right: 34rpx;
  top: 26rpx;
  height: 1rpx;
  background: rgba(255,255,255,0.18);
}
.hero::after {
  content: '';
  position: absolute;
  right: -80rpx;
  bottom: -120rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: rgba(255, 184, 77, 0.28);
}
.hero-copy { position: relative; z-index: 2; max-width: 430rpx; }
.hero-greet {
  display: inline-flex;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.13);
  font-size: 24rpx;
  color: rgba(255,255,255,0.86);
}
.hero-title {
  font-size: 54rpx;
  font-weight: 800;
  color: #fff;
  margin-top: 18rpx;
  line-height: 1.08;
}
.hero-sub {
  font-size: 25rpx;
  color: rgba(255,255,255,0.76);
  margin-top: 18rpx;
  line-height: 1.55;
}
.hero-orbit {
  position: relative;
  z-index: 2;
  width: 156rpx;
  height: 156rpx;
  border: 2rpx solid rgba(255,255,255,0.22);
  border-radius: 50%;
  flex-shrink: 0;
}
.orbit-core {
  position: absolute;
  left: 26rpx;
  top: 26rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 34rpx;
  background: rgba(255,255,255,0.92);
  box-shadow: 0 14rpx 28rpx rgba(12, 18, 30, 0.18), inset 0 1rpx 0 rgba(255,255,255,0.9);
  display: flex;
  align-items: center;
  justify-content: center;
}
.core-grid {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.core-cell {
  width: 34rpx;
  height: 34rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.32);
}
.cell-blue { background: linear-gradient(145deg, #7bc8ff, #2d7dd2); }
.cell-gold { background: linear-gradient(145deg, #ffc25a, #f4a62a); }
.cell-mint { background: linear-gradient(145deg, #58d6a2, #25a974); }
.cell-rose { background: linear-gradient(145deg, #ff8ca0, #e66a7a); }
.orbit-dot {
  position: absolute;
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
}
.dot-a { left: 8rpx; top: 30rpx; background: #ffb84d; }
.dot-b { right: 12rpx; top: 18rpx; background: #58d6a2; }
.dot-c { right: 18rpx; bottom: 18rpx; background: #ff7f8f; }

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 2rpx 4rpx 20rpx;
}
.section-kicker {
  font-size: 20rpx;
  color: var(--muted);
  font-weight: 700;
}
.section-name {
  font-size: 34rpx;
  color: var(--ink);
  font-weight: 800;
  margin-top: 2rpx;
}
.section-count {
  font-size: 23rpx;
  color: var(--primary);
  background: #fff;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  box-shadow: var(--shadow-card);
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}
.grid-item {
  position: relative;
  width: calc((100% - 18rpx) / 2);
  min-height: 232rpx;
  background: linear-gradient(160deg, rgba(255,255,255,0.98), rgba(255,250,242,0.86));
  border-radius: 26rpx;
  box-shadow: var(--shadow-card);
  padding: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform 0.14s ease, box-shadow 0.2s ease;
}
.grid-item::before {
  content: '';
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  top: 0;
  height: 4rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(45,125,210,0.18), rgba(244,166,42,0.18));
}
.grid-item::after {
  content: '';
  position: absolute;
  right: -34rpx;
  top: -34rpx;
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: rgba(45, 125, 210, 0.06);
}
.grid-item:active {
  transform: scale(0.97);
  box-shadow: 0 8rpx 20rpx rgba(48, 42, 35, 0.12);
}

.icon-tile {
  width: 96rpx;
  height: 96rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: inset 0 2rpx 8rpx rgba(255,255,255,0.52), 0 10rpx 20rpx rgba(32,37,50,0.10);
}
.icon-tile .ic { filter: brightness(0) invert(1); }
.tone-blue { background: linear-gradient(145deg, #55a7f2, #2d7dd2); }
.tone-gold { background: linear-gradient(145deg, #ffc25a, #f4a62a); }
.tone-rose { background: linear-gradient(145deg, #ff8ca0, #e66a7a); }
.tone-violet { background: linear-gradient(145deg, #9b8cff, #7866d6); }
.tone-mint { background: linear-gradient(145deg, #58d6a2, #25a974); }
.tone-sky { background: linear-gradient(145deg, #7bc8ff, #2d7dd2); }
.tone-leaf { background: linear-gradient(145deg, #8bdc88, #25a974); }
.tone-ink { background: linear-gradient(145deg, #697386, #202532); }
.tone-orange { background: linear-gradient(145deg, #ffb15f, #f06f38); }
.tone-dark { background: linear-gradient(145deg, #3a4152, #11141d); }

.tool-copy { position: relative; z-index: 2; padding-right: 20rpx; }
.name {
  font-size: 31rpx;
  font-weight: 800;
  color: var(--ink);
}
.desc {
  font-size: 23rpx;
  color: var(--muted);
  margin-top: 8rpx;
  line-height: 1.45;
}
.enter {
  position: absolute;
  right: 22rpx;
  bottom: 18rpx;
  font-size: 21rpx;
  color: var(--ink-2);
  background: #f7f4ee;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 700;
}

.foot { margin-top: 44rpx; }
