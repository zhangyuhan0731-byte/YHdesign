page {
  background: linear-gradient(180deg, #fff8ed 0%, #f4f0e8 48%, #eef4f8 100%);
}

.page {
  min-height: 100vh;
  padding: 28rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
}

.weight-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 4rpx 4rpx 22rpx;
}
.weight-kicker {
  font-size: 20rpx;
  color: var(--muted);
  font-weight: 800;
  letter-spacing: 1.5rpx;
}
.weight-heading {
  font-size: 44rpx;
  font-weight: 900;
  color: var(--ink);
  line-height: 1.15;
}
.unit-pill {
  font-size: 24rpx;
  color: var(--primary);
  background: linear-gradient(135deg, #ffffff, #edf5ff);
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  box-shadow: var(--shadow-card);
  font-weight: 900;
}

.today-card {
  background: linear-gradient(135deg, #ffffff 0%, #edf5ff 100%);
}
.today-label {
  color: var(--muted);
  font-size: 24rpx;
  font-weight: 800;
}
.today-number {
  margin-top: 8rpx;
  font-size: 76rpx;
  line-height: 1.1;
  font-weight: 900;
  color: var(--ink);
}
.today-number text {
  font-size: 28rpx;
  color: var(--muted);
  margin-left: 8rpx;
}
.today-date,
.today-empty {
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: 26rpx;
}
.today-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.form-card,
.trend-card,
.stats-card,
.history-card {
  margin-top: 24rpx;
}
.date-field {
  height: 88rpx;
  border-radius: var(--radius-sm);
  background: #fff;
  border: 2rpx solid rgba(32, 37, 50, 0.06);
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  color: var(--ink);
  font-size: 28rpx;
}
.weight-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.weight-input {
  flex: 1;
  width: auto;      /* 覆盖 .field { width: 100% }，避免在 flex 行内占满整行 */
  min-width: 0;
  background: #fff;
}
.kg {
  width: 84rpx;
  height: 88rpx;
  border-radius: var(--radius-sm);
  background: var(--primary-tint);
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
}
.save-btn { margin-top: 26rpx; }

.trend-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}
.trend-title { margin-bottom: 0; }
.range-tabs {
  display: flex;
  gap: 8rpx;
  background: #f2f7fb;
  padding: 6rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}
.range-tab {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--muted);
  font-weight: 800;
}
.range-tab.active {
  background: #fff;
  color: var(--primary);
  box-shadow: 0 6rpx 14rpx rgba(45,125,210,0.10);
}

.chart-wrap {
  position: relative;
  height: 360rpx;
  margin-top: 28rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
  border-radius: 22rpx;
  overflow: hidden;
}
.chart-canvas {
  width: 100%;
  height: 360rpx;
  display: block;
}
.chart-empty,
.empty-small {
  padding: 46rpx 24rpx;
  text-align: center;
  color: var(--muted);
  background: rgba(255,255,255,0.68);
  border-radius: 22rpx;
  font-size: 25rpx;
}
.change-line {
  margin-top: 18rpx;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: #f7f4ee;
  color: var(--ink-2);
  font-size: 25rpx;
  font-weight: 800;
}
.change-line.up { color: #e8756b; background: #fff0ed; }
.change-line.down { color: #25a974; background: #eaf8f2; }

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}
.stat-item {
  padding: 22rpx;
  border-radius: 20rpx;
  background: #f8fbff;
}
.stat-item.wide {
  grid-column: 1 / 3;
}
.stat-label {
  font-size: 22rpx;
  color: var(--muted);
  font-weight: 800;
}
.stat-value {
  margin-top: 6rpx;
  font-size: 32rpx;
  color: var(--ink);
  font-weight: 900;
}

.history-item {
  display: grid;
  grid-template-columns: 156rpx minmax(76rpx, 1fr) 156rpx;
  align-items: center;
  column-gap: 10rpx;
  padding: 24rpx 0;
}
.history-item + .history-item {
  border-top: 1rpx solid var(--line);
}
.history-main {
  min-width: 0;
}
.history-date {
  font-size: 25rpx;
  color: var(--ink);
  font-weight: 900;
  white-space: nowrap;
}
.history-time {
  font-size: 22rpx;
  color: var(--muted);
}
.history-weight {
  min-width: 0;
  font-size: 32rpx;
  color: var(--primary);
  font-weight: 900;
  white-space: nowrap;
  text-align: left;
}
.history-weight text {
  font-size: 22rpx;
  color: var(--muted);
  margin-left: 4rpx;
}
.history-actions {
  display: flex;
  gap: 6rpx;
  width: 156rpx;
  min-width: 0;
}
.mini-btn {
  margin: 0;
  padding: 0;
  width: 74rpx;
  min-width: 0;
  max-width: 74rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #edf5ff;
  color: var(--primary);
  font-size: 21rpx;
  font-weight: 800;
  line-height: 48rpx;
  flex: 0 0 74rpx;
}
.mini-btn.danger {
  background: #fff0ed;
  color: var(--danger);
}
.mini-btn::after { border: none; }
