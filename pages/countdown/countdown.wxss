/* pages/countdown/countdown.wxss */
.page { padding: 28rpx 24rpx 60rpx; }

.count-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 4rpx 4rpx 20rpx;
}
.count-kicker {
  font-size: 20rpx;
  color: var(--muted);
  font-weight: 800;
}
.count-title {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--ink);
  line-height: 1.12;
  margin-top: 4rpx;
}
.count-mark {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: #fff;
  color: var(--primary);
  box-shadow: var(--shadow-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 800;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #202532, #2d7dd2);
  box-shadow: var(--shadow-float);
}
.tip { flex: 1; color: rgba(255,255,255,0.82); }
.add-btn { width: 150rpx; flex-shrink: 0; }
.topbar .btn-primary {
  background: #ffffff;
  color: #202532;
  box-shadow: none;
}

.list { padding-bottom: 40rpx; }

.cd-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  position: relative;
  padding: 28rpx 24rpx;
  background: linear-gradient(135deg, #ffffff, #fffaf2);
  border: 1rpx solid rgba(32, 37, 50, 0.05);
}
.cd-num {
  width: 124rpx;
  height: 124rpx;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}
.cd-num.future { background: linear-gradient(150deg, #edf5ff, #dbeafe); color: var(--primary); }
.cd-num.today { background: linear-gradient(150deg, #ffe9c7, #ffd79a); color: #d98a18; box-shadow: 0 8rpx 18rpx rgba(244,166,42,0.20); }
.cd-num.past { background: #f0f2f4; color: var(--muted); }
.num {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1;
}
.num-unit { font-size: 22rpx; margin-top: 6rpx; }

.cd-main { flex: 1; min-width: 0; padding-right: 12rpx; }
.cd-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink);
}
.cd-date { margin-top: 8rpx; }
.cd-note {
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cd-del {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.cd-del:active { background: #fdeceb; }

/* 编辑弹层 */
.sheet-body { margin: 4rpx 0 20rpx; }
.label { margin: 22rpx 0 12rpx; }
.field.pick { color: var(--primary); font-weight: 600; }
.sheet-actions { display: flex; gap: 20rpx; }
