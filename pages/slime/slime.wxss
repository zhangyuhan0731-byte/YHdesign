page {
  background: linear-gradient(180deg, #f0f8ff 0%, #f4f0e8 58%, #fffaf2 100%);
}

.page {
  min-height: 100vh;
  padding: 28rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.kicker {
  font-size: 22rpx;
  color: #76a7d8;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.title {
  font-size: 44rpx;
  line-height: 1.15;
  color: var(--ink);
  font-weight: 900;
}

.sound-toggle {
  height: 68rpx;
  padding: 0 22rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #fff;
  color: var(--ink-2);
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: var(--shadow-card);
  border: 1rpx solid rgba(255,255,255,0.88);
}
.sound-toggle::after { border: none; }
.sound-toggle.on { color: var(--primary); }
.sound-toggle:active { transform: scale(0.96); }

.stage {
  position: relative;
  height: 620rpx;
  overflow: hidden;
  padding: 0;
  background:
    radial-gradient(circle at 25% 20%, rgba(255, 255, 255, 0.95), rgba(255,255,255,0) 28%),
    linear-gradient(160deg, #ffffff 0%, #eff8ff 52%, #fff8ee 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  touch-action: none;
}

.stage-glow {
  position: absolute;
  width: 520rpx;
  height: 520rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(117,184,255,0.18) 0%, rgba(117,184,255,0) 68%);
}

.slime-wrap {
  position: relative;
  width: 560rpx;
  height: 430rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.slime {
  --slime-color: #7bdcb5;
  --slime-shine: #dffbf0;
  position: relative;
  width: 430rpx;
  height: 310rpx;
  background:
    radial-gradient(ellipse at var(--press-x, 50%) var(--press-y, 54%), rgba(28,45,64,0.26) 0 9%, rgba(255,255,255,0.22) 15%, rgba(255,255,255,0) 30%),
    radial-gradient(circle at 32% 24%, var(--slime-shine) 0 12%, rgba(255,255,255,0) 23%),
    linear-gradient(145deg, var(--slime-shine), var(--slime-color) 42%, var(--slime-color) 100%);
  box-shadow:
    inset -18rpx -28rpx 42rpx rgba(33, 67, 86, 0.14),
    inset 18rpx 18rpx 46rpx rgba(255, 255, 255, 0.42),
    0 34rpx 58rpx rgba(45, 125, 210, 0.18);
  transition: transform 0.16s cubic-bezier(0.18, 0.9, 0.22, 1.2), border-radius 0.22s ease, filter 0.16s ease;
}

.slime.blob { border-radius: 48% 52% 42% 58% / 46% 44% 56% 54%; }
.slime.round { border-radius: 50%; height: 330rpx; }
.slime.squircle { border-radius: 88rpx; height: 300rpx; }
.slime.pressing { transition-duration: 0.07s; }
.slime.clear {
  opacity: 0.92;
  box-shadow:
    inset -14rpx -20rpx 40rpx rgba(33, 67, 86, 0.12),
    inset 20rpx 22rpx 48rpx rgba(255, 255, 255, 0.58),
    0 34rpx 62rpx rgba(45, 125, 210, 0.2);
}
.slime.clear::after {
  content: '';
  position: absolute;
  left: 86rpx;
  top: 48rpx;
  width: 142rpx;
  height: 54rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.48);
  transform: rotate(-18deg);
}
.slime.cloud::before,
.slime.butter::before,
.slime.crunchy::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
}
.slime.cloud::before {
  background-image:
    radial-gradient(circle, rgba(255,255,255,0.42) 0 9rpx, transparent 10rpx),
    radial-gradient(circle, rgba(255,255,255,0.24) 0 7rpx, transparent 8rpx);
  background-size: 86rpx 74rpx, 110rpx 96rpx;
  background-position: 10rpx 18rpx, 38rpx 48rpx;
}
.slime.butter::before {
  background-image:
    linear-gradient(155deg, rgba(255,255,255,0.26) 0 10%, transparent 11% 100%),
    repeating-linear-gradient(0deg, rgba(255,255,255,0.12) 0 6rpx, transparent 7rpx 24rpx);
}
.slime.crunchy::before {
  background-image:
    radial-gradient(circle, rgba(255,255,255,0.5) 0 6rpx, transparent 7rpx),
    radial-gradient(circle, rgba(54,83,110,0.14) 0 4rpx, transparent 5rpx);
  background-size: 58rpx 58rpx, 78rpx 76rpx;
  background-position: 12rpx 18rpx, 42rpx 50rpx;
}

.shine {
  position: absolute;
  left: 78rpx;
  top: 44rpx;
  width: 124rpx;
  height: 58rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.38);
  transform: rotate(-22deg);
}

.face {
  position: absolute;
  left: 50%;
  top: 54%;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  gap: 32rpx;
}
.eye {
  width: 20rpx;
  height: 28rpx;
  border-radius: 50%;
  background: rgba(32, 37, 50, 0.72);
}
.mouth {
  width: 46rpx;
  height: 24rpx;
  border-bottom: 6rpx solid rgba(32, 37, 50, 0.64);
  border-radius: 0 0 40rpx 40rpx;
}

.bubble {
  position: absolute;
  border-radius: 50%;
  border: 3rpx solid rgba(255,255,255,0.42);
  background: rgba(255,255,255,0.15);
  box-shadow: inset 4rpx 5rpx 10rpx rgba(255,255,255,0.22);
  transform: translate(-50%, -50%);
  opacity: 0.72;
}
.slime.pressing .bubble {
  animation: bubblePop 0.34s ease-out both;
}
@keyframes bubblePop {
  0% { transform: translate(-50%, -50%) scale(1); opacity: 0.72; }
  70% { transform: translate(-50%, -50%) scale(1.36); opacity: 0.42; }
  100% { transform: translate(-50%, -50%) scale(0.45); opacity: 0; }
}

.dent {
  position: absolute;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  border: 8rpx solid rgba(255,255,255,0.42);
  background:
    radial-gradient(circle, rgba(24,43,60,0.24) 0 28%, rgba(255,255,255,0.26) 42%, rgba(255,255,255,0) 66%);
  box-shadow: inset 0 12rpx 18rpx rgba(28,45,64,0.12);
  animation: dentFade 0.54s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}
@keyframes dentFade {
  from { opacity: 0.98; transform: translate(-50%, -50%) scale(0.52); }
  62% { opacity: 0.84; transform: translate(-50%, -50%) scale(1); }
  to { opacity: 0; transform: translate(-50%, -50%) scale(1.42); }
}

.stretch-line {
  position: absolute;
  height: 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,0.48), rgba(255,255,255,0));
  box-shadow: 0 0 18rpx rgba(255,255,255,0.24);
  animation: strandFade 0.46s ease-out forwards;
}
@keyframes strandFade {
  from { opacity: 0.88; height: 18rpx; }
  to { opacity: 0; height: 4rpx; }
}

.stage-hint {
  position: absolute;
  bottom: 28rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 24rpx;
  color: #8aa5ba;
  z-index: 3;
}

.section {
  margin-top: 26rpx;
}

.preset-scroll {
  width: 100%;
  white-space: nowrap;
}
.preset-row {
  display: flex;
  gap: 18rpx;
  padding: 4rpx 2rpx 12rpx;
}
.preset {
  flex: 0 0 184rpx;
  padding: 20rpx 18rpx;
  border-radius: 24rpx;
  background: rgba(255,255,255,0.76);
  border: 2rpx solid rgba(45,125,210,0.05);
  box-shadow: 0 10rpx 24rpx rgba(45,125,210,0.07);
}
.preset.active {
  border-color: rgba(45,125,210,0.34);
  background: #fff;
}
.mini-slime {
  --slime-color: #75b8ff;
  --slime-shine: #e3f2ff;
  width: 86rpx;
  height: 62rpx;
  margin-bottom: 14rpx;
  background: linear-gradient(145deg, var(--slime-shine), var(--slime-color));
  box-shadow: inset -7rpx -9rpx 18rpx rgba(33,67,86,0.14);
}
.mini-slime.blob { border-radius: 48% 52% 42% 58% / 46% 44% 56% 54%; }
.mini-slime.round { border-radius: 50%; }
.mini-slime.squircle { border-radius: 24rpx; }
.preset-name {
  font-size: 25rpx;
  color: var(--ink);
  font-weight: 800;
}
.preset-meta {
  margin-top: 2rpx;
  font-size: 21rpx;
  color: var(--muted);
}

.custom-card {
  margin-top: 18rpx;
}
.label {
  margin: 20rpx 0 12rpx;
  font-size: 24rpx;
  color: var(--muted);
  font-weight: 700;
}
.choice-row,
.seg-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.color-choice {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 8rpx 20rpx rgba(45,125,210,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}
.color-choice.chosen {
  outline: 3rpx solid rgba(45,125,210,0.45);
}
.color-check {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #fff;
}
.seg {
  min-width: 132rpx;
  text-align: center;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #f2f7fb;
  color: var(--ink-2);
  font-size: 25rpx;
  font-weight: 800;
  border: 2rpx solid transparent;
}
.seg.chosen {
  color: var(--primary);
  background: #edf5ff;
  border-color: rgba(45,125,210,0.24);
}
.make-btn {
  margin-top: 28rpx;
}
