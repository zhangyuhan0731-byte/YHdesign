page {
  background: linear-gradient(180deg, #fff8ed 0%, #f4f0e8 52%, #eef4f8 100%);
}

.page {
  min-height: 100vh;
  padding: 28rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
}

.mood-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 4rpx 4rpx 22rpx;
}

.mood-kicker {
  font-size: 20rpx;
  color: var(--muted);
  font-weight: 800;
  letter-spacing: 1.5rpx;
}

.mood-heading {
  font-size: 44rpx;
  font-weight: 900;
  color: var(--ink);
  line-height: 1.15;
}

.date-pill {
  font-size: 23rpx;
  color: var(--primary);
  background: linear-gradient(135deg, #ffffff, #edf5ff);
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  box-shadow: var(--shadow-card);
}

.today-card,
.calendar-card {
  background: linear-gradient(135deg, #ffffff 0%, #fffaf2 100%);
}

.today-preview {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

.today-copy { flex: 1; min-width: 0; }
.today-name {
  font-size: 34rpx;
  font-weight: 900;
  color: var(--ink);
}
.today-tip {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.mood-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 26rpx;
}

.mood-option {
  min-height: 126rpx;
  border-radius: 22rpx;
  background: var(--mood-soft);
  border: 2rpx solid rgba(32, 37, 50, 0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: transform 0.12s ease, box-shadow 0.2s ease;
}
.mood-option.disabled { opacity: 0.45; }
.mood-option:active { transform: scale(0.96); }
.mood-option.disabled:active { transform: none; }
.mood-option.active {
  background: #fff;
  border-color: var(--mood-color);
  box-shadow: 0 12rpx 28rpx rgba(45, 125, 210, 0.12);
}

.mood-name {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  font-weight: 800;
}

.mood-face {
  --face-color: #ffbd78;
  position: relative;
  background: var(--face-color);
  overflow: visible;
  flex-shrink: 0;
  box-shadow:
    inset -5rpx -7rpx 0 rgba(60, 54, 66, 0.06),
    0 10rpx 22rpx rgba(45, 125, 210, 0.10);
}
.big-face {
  width: 112rpx;
  height: 112rpx;
}
.option-face {
  width: 62rpx;
  height: 62rpx;
}
.mini-face {
  width: 42rpx;
  height: 42rpx;
  box-shadow: none;
}

.mood-happy,
.mood-calm,
.mood-tired,
.mood-sad,
.mood-angry {
  border-radius: 50%;
}
.eye,
.mouth,
.cheek,
.face-mark {
  position: absolute;
}
.eye {
  width: 8%;
  height: 8%;
  background: #3f434c;
  border-radius: 50%;
  top: 43%;
}
.eye-l { left: 31%; }
.eye-r { right: 31%; }
.mouth {
  left: 50%;
  top: 58%;
  transform: translateX(-50%);
}
.cheek {
  width: 9%;
  height: 10%;
  border-radius: 50%;
  background: rgba(232, 83, 91, 0.24);
  top: 55%;
}
.cheek-l { left: 18%; }
.cheek-r { right: 18%; }
.face-mark { display: none; }

.mood-happy .eye {
  width: 7%;
  height: 7%;
  top: 40%;
}
.mood-happy .mouth {
  width: 22%;
  height: 18%;
  top: 51%;
  background: #e45548;
  border-radius: 10rpx 10rpx 32rpx 32rpx;
}
.mood-happy .mark-a {
  display: block;
  left: -2%;
  top: 7%;
  width: 19%;
  height: 6%;
  background: #ee8b52;
  border-radius: 999rpx;
  transform: rotate(-46deg);
}
.mood-happy .mark-b {
  display: block;
  left: 6%;
  top: -1%;
  width: 8%;
  height: 17%;
  background: #ee8b52;
  border-radius: 999rpx;
  transform: rotate(30deg);
}

.mood-calm .eye {
  width: 22%;
  height: 8%;
  top: 43%;
  border-radius: 999rpx;
}
.mood-calm .eye-l { left: 26%; }
.mood-calm .eye-r { right: 26%; }
.mood-calm .mouth {
  width: 16%;
  height: 10%;
  top: 58%;
  border-bottom: 5rpx solid #3f434c;
  border-radius: 0 0 999rpx 999rpx;
}
.mini-face.mood-calm .mouth {
  border-bottom-width: 3rpx;
}

.mood-normal {
  background: transparent;
  box-shadow: none;
  border-radius: 0;
}
.mood-happy,
.mood-sad,
.mood-angry,
.mood-tired {
  background: transparent;
  box-shadow: none;
  border-radius: 0;
}
.mood-img {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 118%;
  height: 118%;
  transform: translate(-50%, -50%);
  z-index: 2;
}
.mood-normal .eye,
.mood-normal .mouth,
.mood-normal .cheek,
.mood-normal .face-mark,
.mood-normal::before,
.mood-normal::after,
.mood-happy .eye,
.mood-happy .mouth,
.mood-happy .cheek,
.mood-happy .face-mark,
.mood-happy::before,
.mood-happy::after,
.mood-sad .eye,
.mood-sad .mouth,
.mood-sad .cheek,
.mood-sad .face-mark,
.mood-sad::before,
.mood-sad::after,
.mood-angry .eye,
.mood-angry .mouth,
.mood-angry .cheek,
.mood-angry .face-mark,
.mood-angry::before,
.mood-angry::after,
.mood-tired .eye,
.mood-tired .mouth,
.mood-tired .cheek,
.mood-tired .face-mark,
.mood-tired::before,
.mood-tired::after {
  display: none;
}

.mood-tired .eye {
  width: 24%;
  height: 6%;
  border-radius: 999rpx;
  top: 42%;
}
.mood-tired .eye-l {
  left: 24%;
  transform: rotate(-4deg);
}
.mood-tired .eye-r {
  right: 24%;
  transform: rotate(4deg);
}
.mood-tired .mouth {
  width: 18%;
  height: 10%;
  top: 61%;
  border-top: 5rpx solid #3f434c;
  border-radius: 999rpx 999rpx 0 0;
}
.mood-tired .mark-a {
  display: block;
  right: -2%;
  top: 18%;
  width: 15%;
  height: 42%;
  background: rgba(225, 241, 245, 0.78);
  border-radius: 50% 50% 70% 70%;
  transform: rotate(12deg);
}

.mood-sad .eye {
  width: 25%;
  height: 18%;
  border-radius: 46% 54% 42% 58% / 52% 44% 56% 48%;
  top: 45%;
  background:
    radial-gradient(ellipse at 48% 50%, #ffffff 0 22%, rgba(255,255,255,0) 23%),
    radial-gradient(ellipse at 70% 78%, #ffffff 0 13%, rgba(255,255,255,0) 14%),
    #303236;
}
.mood-sad .eye-l {
  left: 24%;
  transform: rotate(-3deg);
}
.mood-sad .eye-r {
  right: 24%;
  transform: rotate(3deg);
}
.mood-sad .mouth {
  display: block;
  width: 24%;
  height: 14%;
  left: 50%;
  top: 68%;
  transform: translateX(-50%);
  background: transparent;
  border-top: 6rpx solid #6870c8;
  border-bottom: none;
  border-left: none;
  border-right: none;
  border-radius: 999rpx 999rpx 0 0;
}
.mood-sad .mark-a {
  display: block;
  right: 12%;
  top: 2%;
  width: 6%;
  height: 27%;
  background: linear-gradient(180deg, #7d85d8, #6870c8);
  border: none;
  border-radius: 999rpx;
  box-shadow:
    14rpx 8rpx 0 #747dd4,
    28rpx 18rpx 0 #6870c8;
}
.mood-sad .mark-b {
  display: block;
  left: 29%;
  top: 61%;
  width: 7%;
  height: 18%;
  background: #ffffff;
  border-radius: 50% 50% 62% 62%;
  transform: rotate(-3deg);
}
.mood-sad .cheek {
  display: none;
}

.mood-angry .eye {
  width: 20%;
  height: 7%;
  border-radius: 999rpx;
  top: 40%;
}
.mood-angry .eye-l {
  left: 25%;
  transform: rotate(22deg);
}
.mood-angry .eye-r {
  right: 25%;
  transform: rotate(-22deg);
}
.mood-angry .mouth {
  width: 20%;
  height: 10%;
  top: 63%;
  border-top: 5rpx solid #3f434c;
  border-radius: 999rpx 999rpx 0 0;
}
.mood-angry .mark-a,
.mood-angry .mark-b {
  display: block;
  background: #4d4f59;
  border-radius: 999rpx;
}
.mood-angry .mark-a {
  right: 10%;
  top: -4%;
  width: 7%;
  height: 26%;
  transform: rotate(5deg);
}
.mood-angry .mark-b {
  right: 0;
  top: 12%;
  width: 25%;
  height: 7%;
  transform: rotate(-3deg);
}

.mini-face .cheek,
.mini-face .mark-b {
  display: none;
}
.mini-face .mouth {
  border-width: 3rpx;
}

.note-field {
  height: 150rpx;
  background: #fff;
}
.note-field[disabled] {
  color: var(--ink-2);
  background: rgba(255,255,255,0.65);
}
.note-count {
  text-align: right;
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 8rpx;
}

/* 一句话日记输入框：带边框背景 + 文字垂直居中 */
.mood-page .auto-area {
  background: #faf8f4;
  border: 2rpx solid rgba(32, 37, 50, 0.08);
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
}
.save-btn { margin-top: 22rpx; }

.calendar-card { margin-top: 24rpx; }
.calendar-top,
.month-row,
.week-row {
  display: flex;
  align-items: center;
}
.calendar-top {
  justify-content: space-between;
}
.calendar-title { margin-bottom: 0; }
.today-btn,
.month-btn {
  margin: 0;
  padding: 0;
  border: none;
  background: #edf5ff;
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
}
.today-btn::after,
.month-btn::after { border: none; }
.today-btn {
  height: 58rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.month-row {
  justify-content: center;
  gap: 28rpx;
  margin: 26rpx 0 20rpx;
}
.month-btn {
  width: 56rpx;
  min-width: 0;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0;
  flex: 0 0 56rpx;
  border-radius: 50%;
}
.month-btn.next {
  transform: rotate(180deg);
}
.month-btn.today-round {
  background: linear-gradient(135deg, #e8f4fd, #d6ecff);
  border: 2rpx solid rgba(45, 125, 210, 0.16);
}
.month-btn.today-round:active {
  transform: scale(0.92);
  background: linear-gradient(135deg, #d6ecff, #c4e4ff);
}
.month-text {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--ink);
}

.week-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  margin-bottom: 10rpx;
}
.week-cell {
  text-align: center;
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 800;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}
.day-cell {
  position: relative;
  height: 78rpx;
  border-radius: 18rpx;
  background: rgba(255,255,255,0.72);
  border: 2rpx solid rgba(32, 37, 50, 0.035);
  display: flex;
  align-items: center;
  justify-content: center;
}
.day-cell:active { transform: scale(0.95); }
.day-cell.muted-day {
  opacity: 0.38;
}
.day-cell.today {
  background: rgba(45, 125, 210, 0.06);
}
.day-cell.selected {
  background: #edf5ff;
  border-color: var(--primary);
}
.day-num {
  position: absolute;
  left: 10rpx;
  top: 6rpx;
  font-size: 20rpx;
  color: var(--muted);
  font-weight: 700;
}
.selected-card {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #fff;
  display: flex;
  gap: 18rpx;
  border: 1rpx solid rgba(32, 37, 50, 0.05);
}
.selected-mood {
  width: 70rpx;
  height: 70rpx;
  flex-shrink: 0;
}
.selected-copy { flex: 1; min-width: 0; }
.selected-title {
  font-size: 25rpx;
  color: var(--ink);
  font-weight: 900;
}
.selected-note {
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: 25rpx;
  line-height: 1.55;
  word-break: break-all;
}
.empty-small {
  margin-top: 24rpx;
  padding: 32rpx;
  text-align: center;
  color: var(--muted);
  background: rgba(255,255,255,0.62);
  border-radius: 22rpx;
  font-size: 25rpx;
}
