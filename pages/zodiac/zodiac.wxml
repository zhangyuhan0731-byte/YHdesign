<!-- pages/zodiac/zodiac.wxml -->
<view class="page">
  <view class="tool-head anim">
    <view>
      <view class="tool-kicker">ZODIAC MATCH</view>
      <view class="tool-title">生肖匹配</view>
      <view class="tool-sub">选择两个人的生肖，看看相处节奏。</view>
    </view>
    <view class="head-mark">合</view>
  </view>

  <view class="pickers">
    <view class="picker-card card anim">
      <view class="avatar"><view class="ic zodiac-icon zodiac-{{idxA}}"></view></view>
      <view class="who">我</view>
      <picker mode="selector" range="{{zodiacs}}" value="{{idxA}}" bindchange="onPickA">
        <view class="pick-val">{{zA}} ›</view>
      </picker>
    </view>
    <view class="vs-badge">VS</view>
    <view class="picker-card card anim" style="animation-delay:80ms">
      <view class="avatar"><view class="ic zodiac-icon zodiac-{{idxB}}"></view></view>
      <view class="who">TA</view>
      <picker mode="selector" range="{{zodiacs}}" value="{{idxB}}" bindchange="onPickB">
        <view class="pick-val">{{zB}} ›</view>
      </picker>
    </view>
  </view>

  <view class="card result anim" wx:if="{{result}}">
    <view class="score-ring" style="--p:{{result.score}};--c:{{result.levelColor}}">
      <view class="score-ring-inner">
        <view class="score">{{result.score}}</view>
        <view class="score-unit">分</view>
      </view>
    </view>
    <view class="meta">
      <view class="level" style="background:{{result.levelColor}}">{{result.levelLabel}}</view>
      <view class="relation">关系：{{result.relation}}</view>
      <view class="elems">
        <text class="zodiac">{{zA}}</text>
        <text class="plus">与</text>
        <text class="zodiac">{{zB}}</text>
      </view>
    </view>
  </view>

  <view class="card anim" style="animation-delay:160ms">
    <view class="comment">{{result.comment}}</view>
  </view>

  <view class="muted tiny tc foot">六合最合、三合相帮、相冲需包容，纯属娱乐～</view>
</view>
