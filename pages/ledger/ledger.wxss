/* pages/ledger/ledger.wxss */
.page { padding: 28rpx 24rpx 60rpx; }

/* ---------- 月份导航 + 余额胶囊 ---------- */
.month-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 26rpx;
}
.month-group {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}
.month-arrow {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f8fc;
  color: var(--ink-2);
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1;
  flex-shrink: 0;
}
.month-arrow:active { background: #e8f0f8; }
.month-arrow.disabled {
  color: #c7d2dd;
  background: #f7f9fb;
}
.month-current {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--ink);
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}
.month-current:active { background: var(--primary-tint); }
.month-caret {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

/* 右上角余额胶囊 */
.balance-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 60rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 700;
  flex-shrink: 0;
  max-width: 300rpx;
}
.balance-chip:active { opacity: 0.75; }
.balance-chip.on {
  background: #edf5ff;
  border: 2rpx solid #b8d4f0;
}
.balance-chip.on .balance-chip-label { color: var(--muted); }
.balance-chip.on .balance-chip-value {
  color: var(--primary);
  font-weight: 800;
  font-size: 25rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.balance-chip.neg {
  background: #fdecea;
  border: 2rpx solid #f2c4c0;
}
.balance-chip.neg .balance-chip-label { color: var(--muted); }
.balance-chip.neg .balance-chip-value {
  color: var(--danger);
  font-weight: 800;
  font-size: 25rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.balance-chip.off {
  background: transparent;
  border: 2rpx dashed #c7d2dd;
  color: var(--muted);
}
.balance-chip-plus {
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.summary {
  background: linear-gradient(160deg, #ffffff 0%, #edf5ff 62%, #fffaf2 100%);
  border: 1rpx solid rgba(45, 125, 210, 0.10);
}
.summary-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}
.summary-label {
  font-size: 24rpx;
  color: var(--muted);
  font-weight: 700;
}
.balance {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--ink);
  line-height: 1.1;
  word-break: break-all;
}
.summary-grid {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}
.summary-item {
  flex: 1;
  padding: 22rpx;
  border-radius: 22rpx;
  background: rgba(255,255,255,0.78);
  border: 1rpx solid rgba(32, 37, 50, 0.05);
}
.item-label {
  font-size: 23rpx;
  color: var(--muted);
  font-weight: 700;
}
.item-value {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 800;
}
.income { color: #25a974; }
.expense { color: #e66a7a; }

/* ---------- 月预算（弱化：单行轻提示） ---------- */
.budget-lite {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--hairline);
}
.budget-lite:active { opacity: 0.7; }
.budget-lite-track {
  width: 110rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #eef0e9;
  overflow: hidden;
  flex-shrink: 0;
}
.budget-lite-bar {
  height: 100%;
  border-radius: 999rpx;
  background: var(--mint);
  transition: width 0.3s ease;
}
.budget-lite-bar.over { background: var(--danger); }
.budget-lite-text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: var(--muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.budget-lite-text.over { color: var(--danger); font-weight: 700; }
.budget-lite-edit {
  font-size: 22rpx;
  color: var(--primary);
  flex-shrink: 0;
}
.budget-hint {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--hairline);
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
}
.budget-hint:active { color: var(--ink-2); }

.stats-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 26rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #1e3a5f, #2d7dd2);
  box-shadow: 0 12rpx 26rpx rgba(45, 125, 210, 0.22);
}
.stats-entry:active { transform: scale(0.98); }
.stats-entry-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 7rpx;
  padding-bottom: 16rpx;
  flex-shrink: 0;
}
.mini-bar {
  width: 10rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.75);
}
.mini-bar.b1 { height: 18rpx; }
.mini-bar.b2 { height: 30rpx; }
.mini-bar.b3 { height: 24rpx; background: #ffd58a; }
.stats-entry-text { flex: 1; min-width: 0; }
.stats-entry-title {
  font-size: 29rpx;
  font-weight: 800;
  color: #fff;
}
.stats-entry-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}
.stats-entry-arrow {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1;
}

.add-main { margin: 24rpx 0 28rpx; }

.list-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 0 4rpx 18rpx;
}
.list-kicker {
  font-size: 20rpx;
  color: var(--muted);
  font-weight: 800;
}
.list-title {
  font-size: 34rpx;
  color: var(--ink);
  font-weight: 800;
  margin-top: 2rpx;
}
.list-tools {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.list-count {
  font-size: 23rpx;
  color: var(--primary);
  background: #fff;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  box-shadow: var(--shadow-card);
}
.search-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  box-shadow: var(--shadow-card);
  color: var(--ink-2);
}
.search-btn.active {
  background: var(--primary);
  color: #fff;
}

/* ---------- 搜索行 ---------- */
.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 22rpx;
}
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 70rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 2rpx solid rgba(45, 125, 210, 0.14);
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
  color: var(--muted);
}
.search-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  font-size: 26rpx;
  color: var(--ink);
}
.search-clear {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef0e9;
  color: var(--ink-2);
  font-size: 26rpx;
  line-height: 1;
  flex-shrink: 0;
}
.search-cancel {
  font-size: 26rpx;
  color: var(--ink-2);
  font-weight: 700;
  flex-shrink: 0;
  padding: 6rpx 4rpx;
}

/* ---------- 类型筛选 ---------- */
.filter-tabs {
  display: flex;
  gap: 14rpx;
  margin-bottom: 22rpx;
}
.filter-tab {
  flex: 1;
  height: 66rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border: 2rpx solid rgba(32, 37, 50, 0.06);
  color: var(--ink-2);
  font-size: 25rpx;
  font-weight: 700;
}
.filter-tab.active {
  background: #edf5ff;
  border-color: #9cc8f5;
  color: var(--primary);
}

/* ---------- 按日分组 ---------- */
.day-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 10rpx 12rpx;
}
.day-label {
  font-size: 25rpx;
  font-weight: 800;
  color: var(--ink-2);
}
.day-sum {
  font-size: 22rpx;
  color: var(--muted);
}

.bill-list { padding-bottom: 40rpx; }

/* ---------- 滚动加载提示 ---------- */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 30rpx 0 10rpx;
  font-size: 23rpx;
  color: var(--muted);
}
.load-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #c9d4de;
  animation: loadPulse 1s ease infinite;
}
.load-dot:nth-child(2) { animation-delay: 0.15s; }
.load-dot:nth-child(3) { animation-delay: 0.3s; }
@keyframes loadPulse {
  0%, 100% { opacity: 0.35; transform: translateY(0); }
  50% { opacity: 1; transform: translateY(-6rpx); }
}
.load-done {
  padding: 30rpx 0 10rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b6c7d4;
}
.bill-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 22rpx;
  margin-bottom: 18rpx;
  background: linear-gradient(135deg, #ffffff, #fffaf2);
  border: 1rpx solid rgba(32, 37, 50, 0.05);
}
.bill-card:active { transform: scale(0.99); }
.cate-avatar {
  width: 78rpx;
  height: 78rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 800;
}
.bill-main { flex: 1; min-width: 0; }
.bill-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}
.bill-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink);
}
.bill-amount {
  flex-shrink: 0;
  font-size: 31rpx;
  font-weight: 800;
}
.bill-meta {
  margin-top: 7rpx;
  font-size: 23rpx;
  color: var(--muted);
}
.dot { margin: 0 8rpx; }
.bill-note {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.bill-delete {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.bill-delete:active { background: #fdeceb; }

.amount-card {
  display: flex;
  align-items: center;
  height: 108rpx;
  padding: 0 26rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #edf5ff, #ffffff);
  border: 2rpx solid rgba(45, 125, 210, 0.10);
}
.currency {
  font-size: 36rpx;
  color: var(--primary);
  font-weight: 800;
  margin-right: 14rpx;
}
.amount-input {
  flex: 1;
  height: 100%;
  font-size: 44rpx;
  font-weight: 800;
  color: var(--ink);
}
.type-tabs {
  display: flex;
  gap: 16rpx;
}
.type-tab {
  flex: 1;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f7f4ee;
  color: var(--ink-2);
  font-size: 27rpx;
  font-weight: 800;
}
.type-tab.active {
  background: linear-gradient(135deg, #2d7dd2, #25a974);
  color: #fff;
  box-shadow: 0 10rpx 22rpx rgba(45, 125, 210, 0.22);
}
.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.category-chip {
  min-width: 132rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border: 2rpx solid rgba(32, 37, 50, 0.06);
  color: var(--ink-2);
  font-size: 25rpx;
  font-weight: 700;
}
.category-chip.active {
  background: #edf5ff;
  border-color: #9cc8f5;
  color: var(--primary);
}
.category-add {
  color: var(--primary);
  background: #fff;
  border: 2rpx dashed #b8d4f0;
}
.category-add:active {
  background: var(--primary-tint);
}
.add-icon {
  font-size: 28rpx;
  font-weight: 700;
  margin-right: 6rpx;
  line-height: 1;
}
.date-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 82rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: #f7f4ee;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 700;
}
.date-arrow {
  color: var(--muted);
  font-size: 34rpx;
  transform: rotate(90deg);
}
.save-btn {
  margin-top: 24rpx;
  margin-bottom: 16rpx;
}

/* 弹层底部安全间距（覆盖通用 input-sheet 的 16rpx，给保存按钮下方留出呼吸空间） */
.sheet.input-sheet {
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

.remark-input {
  height: 82rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: #f7f4ee;
  color: var(--ink);
  font-size: 27rpx;
  line-height: 82rpx;
  box-sizing: border-box;
}

/* 分类管理弹层（层叠在添加账单弹层之上） */
.cate-mask { z-index: 60; }
.cate-sheet { z-index: 61; }
.cate-type-tabs { margin-bottom: 10rpx; }
.cate-tip {
  margin: 8rpx 2rpx 14rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.cate-chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  padding: 10rpx 0 24rpx;
}
.cate-manage-chip {
  position: relative;
  display: inline-flex;
  align-items: center;
  height: 68rpx;
  padding: 0 16rpx 0 18rpx;
  border-radius: 34rpx;
  font-size: 26rpx;
  font-weight: 700;
  border: 2rpx solid transparent;
}
.chip-text {
  line-height: 1;
}
.chip-del {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 10rpx;
  background: rgba(226, 93, 93, 0.9);
  color: #fff;
}
.chip-del-x {
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  transform: translateY(-1rpx);
}

.cate-add-box {
  background: #faf8f4;
  border-radius: 24rpx;
  padding: 22rpx 24rpx 26rpx;
  margin-bottom: 20rpx;
}
.cate-add-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.cate-add-input {
  flex: 1;
  width: auto;
  min-width: 0;
  background: #fff;
  border: 2rpx solid rgba(32, 37, 50, 0.06);
  border-radius: 20rpx;
  height: 80rpx;
  padding: 0 24rpx;
  font-size: 27rpx;
  line-height: 80rpx;
  box-sizing: border-box;
}
.cate-add-btn {
  width: 132rpx;
  height: 68rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: linear-gradient(135deg, #ff9f43, #2d7dd2);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 22rpx rgba(45, 125, 210, 0.22);
}
.cate-add-btn:active {
  transform: scale(0.97);
  box-shadow: 0 6rpx 14rpx rgba(58, 155, 214, 0.30);
}
.cate-sheet-foot {
  padding-top: 18rpx;
}

/* ---------- 评价入口（添加账单弹层里） ---------- */
.eval-entry {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
  background: #f7f4ee;
  gap: 14rpx;
}
.eval-entry.has-value {
  background: #fafbfd;
  border: 2rpx solid rgba(45, 125, 210, 0.08);
}
.eval-entry-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.eval-entry-name {
  font-size: 28rpx;
  font-weight: 800;
  flex-shrink: 0;
}
.eval-entry-sub {
  font-size: 23rpx;
  color: var(--muted);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  margin-left: 6rpx;
}
.eval-entry-placeholder {
  flex: 1;
  font-size: 26rpx;
  color: var(--muted);
}
.eval-entry-arrow {
  color: var(--muted);
  font-size: 32rpx;
  transform: rotate(90deg);
  flex-shrink: 0;
  line-height: 1;
}
.eval-entry:active {
  background: #efeae0;
}

/* ---------- 评价弹层 ---------- */
.eval-mask { z-index: 55; }
.eval-sheet {
  z-index: 56;
}
.eval-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 8rpx 0 10rpx;
}
.eval-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 22rpx 22rpx 24rpx;
  border-radius: 22rpx;
  background: #faf8f4;
  border: 2rpx solid transparent;
  transition: transform 0.18s ease;
}
.eval-card.active {
  background: #ffffff;
  border-color: rgba(45, 125, 210, 0.18);
  box-shadow: 0 8rpx 18rpx rgba(32, 37, 50, 0.05);
}
.eval-card:active {
  transform: scale(0.98);
}
.eval-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.eval-text {
  flex: 1;
  min-width: 0;
}
.eval-name {
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.2;
}
.eval-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--muted);
}
.eval-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 900;
  background: rgba(255, 255, 255, 0.85);
  flex-shrink: 0;
}

.eval-clear {
  margin-top: 6rpx;
  padding: 20rpx 0 4rpx;
  text-align: center;
  font-size: 25rpx;
  font-weight: 700;
  color: var(--muted);
}
.eval-clear:active { color: var(--danger); }

/* ---------- 自定义评价 ---------- */
.eval-section {
  margin-top: 22rpx;
  padding: 0 4rpx 6rpx;
  font-size: 22rpx;
  color: var(--muted);
  font-weight: 800;
}
.eval-del {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(226, 93, 93, 0.12);
  color: var(--danger);
  font-size: 26rpx;
  line-height: 1;
  flex-shrink: 0;
  margin-left: 12rpx;
}
.eval-del:active { background: rgba(226, 93, 93, 0.22); }
.eval-add {
  margin-top: 18rpx;
  height: 76rpx;
  border-radius: 22rpx;
  border: 2rpx dashed #b8d4f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 700;
  color: var(--primary);
}
.eval-add:active { background: var(--primary-tint); }

/* ---------- 账单列表里的评价彩色标签 ---------- */
.bill-eval {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
