/* app.wxss - 趣玩小工具 全局设计系统 */

page {
  /* 设计令牌 */
  --bg: #f4f0e8;
  --card: #ffffff;
  --card-2: #fffaf2;
  --primary: #2d7dd2;
  --primary-deep: #195fb0;
  --primary-soft: #dbeafe;
  --primary-tint: #edf5ff;
  --ink: #202532;
  --ink-2: #586274;
  --muted: #8c94a3;
  --line: #ece6dc;
  --danger: #e25d5d;
  --gold: #f4a62a;
  --mint: #25a974;
  --rose: #e66a7a;
  --violet: #7866d6;
  --radius: 24rpx;
  --radius-sm: 16rpx;
  --shadow-card: 0 16rpx 42rpx rgba(48, 42, 35, 0.08), 0 3rpx 10rpx rgba(48, 42, 35, 0.05);
  --shadow-float: 0 24rpx 58rpx rgba(48, 42, 35, 0.16);
  --hairline: rgba(32, 37, 50, 0.07);

  background:
    linear-gradient(180deg, #fff8ed 0%, #f4f0e8 42%, #eef4f8 100%);
  color: var(--ink);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
  line-height: 1.55;
}

view, text, button, input, textarea, scroll-view, navigator, image {
  box-sizing: border-box;
}

/* ---------- 布局 ---------- */
.container { padding: 24rpx 24rpx 60rpx; }
.page-pad { padding: 24rpx; }
.row { display: flex; align-items: center; }
.between { justify-content: space-between; }
.wrap { flex-wrap: wrap; }
.col { display: flex; flex-direction: column; }
.flex-1 { flex: 1; min-width: 0; }
.center { align-items: center; justify-content: center; }

/* ---------- 入场动画（stagger） ---------- */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: none; }
}
.anim { opacity: 0; animation: fadeUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards; }

@keyframes pop {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}
.pop { opacity: 0; animation: pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) forwards; }

/* ---------- 卡片 ---------- */
.card {
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow-card);
  padding: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.82);
}
.card-2 { background: var(--card-2); }
.card + .card { margin-top: 24rpx; }

/* ---------- 区块标题 ---------- */
.section-title {
  display: flex;
  align-items: center;
  font-size: 31rpx;
  font-weight: 800;
  color: var(--ink);
  margin-bottom: 22rpx;
  letter-spacing: 0.4rpx;
}
.section-title .bar {
  width: 8rpx;
  height: 30rpx;
  border-radius: 5rpx;
  background: linear-gradient(180deg, #ffb84d, #2d7dd2);
  margin-right: 14rpx;
}
.section-sub { font-size: 23rpx; color: var(--muted); font-weight: 400; }

/* ---------- 文字 ---------- */
.muted { color: var(--muted); }
.ink-2 { color: var(--ink-2); }
.primary-text { color: var(--primary); }
.bold { font-weight: 600; }
.tc { text-align: center; }
.small { font-size: 24rpx; }
.tiny { font-size: 21rpx; }

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 46rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
  border: none;
  transition: transform 0.12s ease, box-shadow 0.2s ease, background 0.2s ease;
}
.btn::after { border: none; }
.btn-primary {
  background: linear-gradient(135deg, #ff9f43, #2d7dd2);
  color: #fff;
  box-shadow: 0 14rpx 28rpx rgba(45, 125, 210, 0.26), inset 0 1rpx 0 rgba(255,255,255,0.28);
}
.btn-primary:active { transform: scale(0.97); box-shadow: 0 6rpx 14rpx rgba(58, 155, 214, 0.30); }
.btn-ghost {
  background: #fff;
  color: var(--primary);
  border: 2rpx solid #d7e6f8;
  box-shadow: 0 8rpx 18rpx rgba(45, 125, 210, 0.07);
}
.btn-ghost:active { background: var(--primary-tint); transform: scale(0.97); }
.btn-danger {
  background: #fff;
  color: var(--danger);
  border: 2rpx solid #f5cdc8;
}
.btn-danger:active { background: #fdecea; transform: scale(0.97); }
.btn-block { width: 100%; }
.btn-sm { height: 68rpx; border-radius: 34rpx; font-size: 26rpx; padding: 0 34rpx; }
.btn[disabled] { opacity: 0.5; }

/* ---------- 标签 / 胶囊 ---------- */
.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: #fffaf2;
  color: var(--primary);
  font-size: 25rpx;
  font-weight: 700;
  border: 1rpx solid rgba(45, 125, 210, 0.08);
  transition: transform 0.15s ease, background 0.2s ease, color 0.2s ease;
}
.chip:active { transform: scale(0.95); }
.chip-active {
  background: linear-gradient(135deg, #2d7dd2, #25a974);
  color: #fff;
  box-shadow: 0 8rpx 18rpx rgba(45, 125, 210, 0.24);
  border-color: transparent;
}
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: var(--primary-tint);
  color: var(--primary);
  font-size: 22rpx;
  margin: 8rpx 10rpx 0 0;
}

/* ---------- 分隔线 ---------- */
.divider { height: 1rpx; background: var(--line); margin: 26rpx 0; }

/* ---------- 空状态 ---------- */
.empty {
  text-align: center;
  color: var(--muted);
  padding: 100rpx 40rpx;
}
.empty .empty-ic {
  width: 150rpx;
  height: 150rpx;
  margin: 0 auto 24rpx;
  opacity: 0.85;
}
.empty .tip { font-size: 26rpx; line-height: 1.7; }
.empty .tip-sub { font-size: 23rpx; color: #b6c7d4; margin-top: 6rpx; }

/* ---------- 输入框 ---------- */
.field {
  width: 100%;
  background: #f7f4ee;
  border: 2rpx solid rgba(32, 37, 50, 0.04);
  border-radius: var(--radius-sm);
  padding: 24rpx;
  font-size: 28rpx;
  color: var(--ink);
  transition: border-color 0.2s ease, background 0.2s ease;
}
input.field {
  height: 88rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}
.field-card input.field { padding: 0; }
textarea.field { height: 200rpx; line-height: 1.6; }
.field-card {
  background: #fff;
  border: 2rpx solid rgba(32, 37, 50, 0.06);
  border-radius: var(--radius-sm);
  padding: 10rpx 24rpx;
  margin-bottom: 22rpx;
}
.field-card .field {
  background: transparent;
  border: none;
  padding-left: 0;
  padding-right: 0;
}
.field-label {
  font-size: 24rpx;
  color: var(--muted);
  margin: 6rpx 0 4rpx;
}

/* 自适应输入区：透明背景、随内容增长/收缩，无大白框（微信/ChatGPT 风）
   - min-height 保证空态只占一行，placeholder 不撑开输入框
   - max-height 限制后超长内容在 textarea 内部滚动（auto-height 设的是 height，
     样式表的 max-height 仍作为盒模型上界生效）
   - 必须配合标签 auto-height + placeholder-class="ph" */
.auto-area {
  width: 100%;
  background: transparent;
  border: none;
  padding: 10rpx 0;
  font-size: 30rpx;
  line-height: 1.5;
  color: var(--ink);
  min-height: 56rpx;
  max-height: 460rpx;
  box-sizing: border-box;
}
.auto-area[disabled] {
  color: var(--ink-2);
  opacity: 0.72;
}
.ph {
  color: var(--muted);
}

/* ---------- 弹层通用（底部） ---------- */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(20, 40, 56, 0.5);
  z-index: 50;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.25s ease, visibility 0.25s ease;
}
.mask.show { opacity: 1; visibility: visible; }
.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 36rpx 36rpx 0 0;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  z-index: 51;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  transform: translateY(100%);
  transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1), bottom 0.2s ease;
  box-shadow: 0 -12rpx 44rpx rgba(58, 155, 214, 0.18);
}
.sheet-body {
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}
.sheet-scroll { max-height: 58vh; }

/* ---------- 声音开关按钮（悬浮） ---------- */
/* 声音开关控制条：统一位置（右上角），随页面滚动 */
.sound-bar {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 14rpx 24rpx 6rpx;
  min-height: 56rpx;
}
.sound-fab {
  position: relative;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: var(--shadow-card);
  border: 1rpx solid rgba(255,255,255,0.8);
  display: flex;
  align-items: center;
  justify-content: center;
}
.sound-fab:active { transform: scale(0.92); }
.bottom-bar {
  justify-content: flex-end;
  padding: 24rpx 24rpx 0;
}
.sheet.show { transform: translateY(0); }
/* 输入型弹层：高度自适应内容，不强制撑满屏幕
   安卓上 transform 祖先会导致原生 input/textarea 定位错乱（键盘弹起时输入框错位/穿透），
   故输入型弹层改用 bottom 定位与滑入动画，彻底不使用 transform */
.sheet.input-sheet {
  min-height: auto;
  max-height: 85vh;
  padding-bottom: 16rpx;
  transform: none;
  bottom: -110%;
  transition: bottom 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}
.sheet.input-sheet.show { transform: none; bottom: var(--kb, 0px); }
.input-sheet .sheet-scroll {
  flex: 1;
  max-height: calc(85vh - 180rpx);
  min-height: 0;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}
.sheet-title { font-size: 33rpx; font-weight: 700; color: var(--ink); }
.sheet-tip { font-size: 23rpx; color: var(--muted); margin: -18rpx 0 26rpx; }

/* ---------- 星级 ---------- */
.stars { display: inline-flex; align-items: center; gap: 6rpx; }
.star { font-size: 30rpx; color: #dde9f1; line-height: 1; }
.star.on { color: var(--gold); }

/* ---------- 通用列表项 ---------- */
.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
}
.list-item + .list-item { border-top: 1rpx solid var(--line); }

/* ---------- 图标（内联 SVG，无 emoji） ---------- */
.ic {
  display: inline-block;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  vertical-align: middle;
}
.ic-w { filter: brightness(0) invert(1); }

