.tips-page { padding: 18rpx 20rpx 52rpx; }

.tips-hero { padding: 8rpx 6rpx 18rpx; }
.hero-title { color: var(--ink); font-size: 38rpx; line-height: 1.25; font-weight: 900; }
.hero-sub { margin-top: 8rpx; color: var(--muted); font-size: 23rpx; font-weight: 600; }

.search-sticky {
  position: sticky;
  top: 0;
  z-index: 20;
  padding: 6rpx 0 16rpx;
  background: rgba(244, 240, 232, .96);
}
.search-box {
  display: flex;
  align-items: center;
  gap: 13rpx;
  height: 78rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(32, 37, 50, .06);
  border-radius: 23rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(48, 42, 35, .07);
}
.search-icon { width: 32rpx; height: 32rpx; flex-shrink: 0; opacity: .72; }
.search-input { flex: 1; min-width: 0; height: 78rpx; color: var(--ink); font-size: 26rpx; }
.clear-search { width: 48rpx; height: 48rpx; margin: 0; padding: 0; border: 0; background: transparent; color: var(--muted); font-size: 38rpx; line-height: 48rpx; }
.clear-search::after { border: 0; }

.tips-list { display: flex; flex-direction: column; gap: 14rpx; }
.tip-card { padding: 0; overflow: hidden; }
.tip-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 24rpx;
}
.tip-head:active { background: #fafafa; }
.tip-badge {
  flex-shrink: 0;
  padding: 7rpx 15rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
}
.tip-prepare { color: #2d7dd2; background: #edf5ff; }
.tip-skill { color: #c87d22; background: #fff7e7; }
.tip-safety { color: #e25d5d; background: #ffeaea; }
.tip-name { flex: 1; min-width: 0; color: var(--ink); font-size: 28rpx; line-height: 1.4; font-weight: 800; }
.tip-arrow {
  flex-shrink: 0;
  color: var(--muted);
  font-size: 40rpx;
  line-height: 1;
  transition: transform .2s ease;
}
.tip-arrow.up { transform: rotate(180deg); }

.tip-body {
  padding: 4rpx 24rpx 28rpx;
  border-top: 1rpx solid var(--hairline);
  animation: fadeUp .3s ease forwards;
}
.tip-para { color: var(--ink-2); font-size: 25rpx; line-height: 1.78; }
.tip-para + .tip-para { margin-top: 14rpx; }

.empty { padding: 45rpx 18rpx; text-align: center; }
.empty-symbol { width: 72rpx; height: 72rpx; margin: 0 auto 17rpx; display: flex; align-items: center; justify-content: center; border-radius: 22rpx; color: var(--primary); background: var(--primary-tint); font-size: 36rpx; font-weight: 900; }
.empty .tip { font-size: 24rpx; }
.empty .tip-sub { font-size: 20rpx; }
.empty-reset { height: 66rpx; margin-top: 20rpx; padding: 0 20rpx; font-size: 22rpx; }
