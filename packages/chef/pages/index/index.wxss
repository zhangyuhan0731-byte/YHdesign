.chef-page { padding: 18rpx 20rpx 52rpx; }

.search-sticky {
  position: sticky;
  top: 0;
  z-index: 20;
  padding: 6rpx 0 15rpx;
  background: rgba(244, 240, 232, .96);
}
.search-box {
  display: flex;
  align-items: center;
  gap: 13rpx;
  height: 78rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(32, 37, 50, .06);
  border-radius: 23rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(48, 42, 35, .07);
}
.search-icon { width: 32rpx; height: 32rpx; flex-shrink: 0; opacity: .72; }
.search-input { flex: 1; min-width: 0; height: 78rpx; color: var(--ink); font-size: 26rpx; }
.clear-search { width: 48rpx; height: 48rpx; margin: 0; padding: 0; border: 0; background: transparent; color: var(--muted); font-size: 38rpx; line-height: 48rpx; }
.clear-search::after { border: 0; }

.browse-layout { display: flex; align-items: flex-start; gap: 15rpx; }
.category-column {
  position: sticky;
  top: 99rpx;
  width: 168rpx;
  max-height: calc(100vh - 125rpx);
  flex-shrink: 0;
  overflow: hidden;
  border: 1rpx solid rgba(32, 37, 50, .05);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, .72);
  box-shadow: 0 8rpx 24rpx rgba(48, 42, 35, .05);
}
.category-item {
  position: relative;
  min-height: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 13rpx 8rpx;
  color: var(--ink-2);
  background: transparent;
}
.category-item + .category-item { border-top: 1rpx solid rgba(32, 37, 50, .045); }
.category-item.active { color: #cc6f1c; background: #fff6e9; }
.category-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 20rpx;
  bottom: 20rpx;
  width: 7rpx;
  border-radius: 0 8rpx 8rpx 0;
  background: #e48a2a;
}
.category-name { font-size: 25rpx; line-height: 1.3; font-weight: 800; }
.category-count { margin-top: 5rpx; color: var(--muted); font-size: 19rpx; line-height: 1.2; font-weight: 600; }
.category-item.active .category-count { color: #d5975a; }

.recipe-column { flex: 1; min-width: 0; }
.result-head { display: flex; align-items: center; justify-content: space-between; min-height: 58rpx; padding: 0 4rpx 10rpx; }
.result-title { color: var(--ink); font-size: 28rpx; font-weight: 900; }
.result-count { color: var(--muted); font-size: 21rpx; font-weight: 700; }

.recipe-card { position: relative; padding: 20rpx; }
.recipe-card + .recipe-card { margin-top: 14rpx; }
.recipe-card:active { transform: scale(.985); }
.recipe-card-top { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; }
.category-badge { padding: 5rpx 11rpx; border-radius: 999rpx; color: var(--primary); background: var(--primary-tint); font-size: 18rpx; font-weight: 800; }
.difficulty-stars { flex-shrink: 0; color: var(--gold); font-size: 18rpx; letter-spacing: 0; }
.recipe-name { margin-top: 13rpx; color: var(--ink); font-size: 31rpx; line-height: 1.28; font-weight: 900; }
.ingredient-preview {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.52;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.recipe-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx; margin-top: 14rpx; padding-right: 82rpx; }
.meta-pill { padding: 5rpx 10rpx; border-radius: 999rpx; color: #5f6b7d; background: #f5f7fa; font-size: 18rpx; font-weight: 700; }
.meta-pill.calorie { color: #c87d22; background: #fff7e7; }
.open-copy { position: absolute; right: 18rpx; bottom: 23rpx; color: var(--primary); font-size: 19rpx; font-weight: 800; }
.load-tip { padding: 28rpx 0 8rpx; text-align: center; color: var(--muted); font-size: 20rpx; }

.empty { padding: 45rpx 18rpx; text-align: center; }
.empty-symbol { width: 72rpx; height: 72rpx; margin: 0 auto 17rpx; display: flex; align-items: center; justify-content: center; border-radius: 22rpx; color: var(--primary); background: var(--primary-tint); font-size: 36rpx; font-weight: 900; }
.empty .tip { font-size: 24rpx; }
.empty .tip-sub { font-size: 20rpx; }
.empty-reset { height: 66rpx; margin-top: 20rpx; padding: 0 20rpx; font-size: 22rpx; }
.source-note { padding: 30rpx 4rpx 0; text-align: center; color: #a0a7b3; font-size: 18rpx; line-height: 1.5; }

/* ---------- 快捷入口：厨房小贴士 ---------- */
.quick-bar { display: flex; padding: 2rpx 0 14rpx; }
.quick-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  height: 66rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ffffff, #fff6e9);
  box-shadow: 0 8rpx 20rpx rgba(226, 138, 42, .14);
  color: #cc6f1c;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
}
.quick-pill::after { border: 0; }
.quick-pill:active { transform: scale(.97); }
.quick-pill .ic { width: 30rpx; height: 30rpx; }
.quick-sub { margin-left: 2rpx; padding: 4rpx 12rpx; border-radius: 999rpx; background: rgba(226, 138, 42, .14); color: #d5975a; font-size: 19rpx; font-weight: 800; line-height: 1; }

/* ---------- 收藏分类入口 ---------- */
.fav-item { background: rgba(255, 255, 255, .5); }
.fav-item.active { color: #e25d5d; background: #fff0f0; }
.fav-item.active::before { background: #e25d5d; }
.fav-item.active .category-count { color: #e89aa6; }
.cat-fav-row { display: flex; align-items: center; gap: 10rpx; }
.fav-ic { width: 26rpx; height: 26rpx; }

/* ---------- 结果头部：返回 / 换一批 ---------- */
.result-head { display: flex; align-items: center; justify-content: space-between; min-height: 58rpx; padding: 0 4rpx 10rpx; gap: 12rpx; }
.head-left { display: flex; align-items: center; gap: 14rpx; min-width: 0; }
.head-right { display: flex; align-items: center; gap: 14rpx; flex-shrink: 0; }
.back-link { display: inline-flex; align-items: center; height: 48rpx; margin: 0; padding: 0 6rpx; border: 0; background: transparent; color: var(--muted); font-size: 24rpx; font-weight: 800; line-height: 1; }
.back-link::after { border: 0; }
.back-link:active { opacity: .6; }
.shuffle-btn {
  display: inline-flex;
  align-items: center;
  gap: 7rpx;
  height: 52rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 0;
  border-radius: 999rpx;
  background: var(--primary-tint);
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}
.shuffle-btn::after { border: 0; }
.shuffle-btn:active { transform: scale(.95); background: #dbeafe; }
.shuffle-btn .ic { width: 26rpx; height: 26rpx; }

/* ---------- 卡片收藏角标 ---------- */
.recipe-card-top { padding-right: 62rpx; }
.fav-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, .72);
  box-shadow: 0 6rpx 16rpx rgba(48, 42, 35, .1);
  border: 1rpx solid rgba(32, 37, 50, .06);
  z-index: 2;
}
.fav-badge .ic { width: 30rpx; height: 30rpx; }
.fav-badge:active { transform: scale(.9); }
.fav-badge.on { background: linear-gradient(135deg, #ff8aa0, #e25d5d); border-color: transparent; box-shadow: 0 6rpx 16rpx rgba(226, 93, 93, .32); }
