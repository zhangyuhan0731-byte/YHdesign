.detail-page { padding: 28rpx 24rpx 58rpx; }
.loading { padding: 120rpx 0; text-align: center; color: var(--muted); font-size: 26rpx; }

.detail-hero {
  padding: 34rpx;
  border-radius: 34rpx;
  color: #fff;
  background: linear-gradient(145deg, #17365d, #2d7dd2 68%, #52b4e1);
  box-shadow: 0 20rpx 48rpx rgba(45,125,210,.24);
}
.hero-row { display: flex; align-items: center; justify-content: space-between; }
.category-badge { padding: 8rpx 17rpx; border-radius: 999rpx; background: rgba(255,255,255,.16); border: 1rpx solid rgba(255,255,255,.18); font-size: 22rpx; font-weight: 800; }

.fav-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, .18);
  border: 1rpx solid rgba(255, 255, 255, .28);
  transition: transform .15s ease, background .2s ease, box-shadow .2s ease;
}
.fav-btn:active { transform: scale(.9); }
.fav-btn .ic { width: 34rpx; height: 34rpx; }
.fav-btn.on {
  background: linear-gradient(135deg, #ff8aa0, #e25d5d);
  border-color: transparent;
  box-shadow: 0 8rpx 18rpx rgba(226, 93, 93, .42);
}
.difficulty { color: #ffd777; font-size: 26rpx; letter-spacing: 2rpx; }
.recipe-title { margin-top: 22rpx; font-size: 48rpx; line-height: 1.2; font-weight: 900; }
.recipe-summary { margin-top: 16rpx; color: rgba(255,255,255,.82); font-size: 25rpx; line-height: 1.7; }
.hero-meta { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 22rpx; }
.hero-pill { padding: 8rpx 16rpx; border-radius: 999rpx; background: rgba(255,255,255,.13); font-size: 22rpx; font-weight: 700; }

.section-card { margin-top: 22rpx; padding: 28rpx; }
.section-heading { display: flex; align-items: center; gap: 12rpx; margin-bottom: 24rpx; color: var(--ink); font-size: 31rpx; font-weight: 900; }
.heading-bar { width: 8rpx; height: 32rpx; border-radius: 8rpx; background: var(--primary); }
.heading-bar.gold { background: var(--gold); }
.heading-bar.green { background: var(--mint); }
.heading-bar.orange { background: #e18a2c; }
.group-title { margin: 20rpx 0 12rpx; color: var(--muted); font-size: 22rpx; font-weight: 800; }
.requirement-group:first-of-type .group-title,
.amount-group:first-of-type .group-title { margin-top: 0; }
.requirement-tags { display: flex; flex-wrap: wrap; gap: 11rpx; }
.requirement-tag { padding: 11rpx 17rpx; border-radius: 16rpx; color: var(--ink-2); background: #f5f7fa; font-size: 24rpx; font-weight: 700; }
.optional { margin-left: 8rpx; color: #d88a23; font-size: 18rpx; }

.amount-group + .amount-group { margin-top: 26rpx; padding-top: 6rpx; border-top: 1rpx solid var(--hairline); }
.amount-note { margin: 0 0 14rpx; padding: 15rpx 17rpx; border-radius: 14rpx; color: var(--ink-2); background: #fff9ed; font-size: 23rpx; line-height: 1.58; }
.amount-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; padding: 17rpx 0; border-bottom: 1rpx solid var(--hairline); }
.amount-row:last-child { border-bottom: none; }
.amount-name { flex: 1; min-width: 0; color: var(--ink); font-size: 25rpx; line-height: 1.5; font-weight: 700; }
.amount-value { max-width: 48%; color: var(--ink-2); text-align: right; font-size: 24rpx; line-height: 1.5; }
.kind-label { margin-left: 10rpx; padding: 3rpx 8rpx; border-radius: 8rpx; color: var(--muted); background: #f4f5f7; font-size: 17rpx; font-weight: 600; }

.step-group + .step-group { margin-top: 30rpx; padding-top: 24rpx; border-top: 1rpx solid var(--hairline); }
.step-group-title { margin-bottom: 20rpx; color: var(--primary); font-size: 27rpx; font-weight: 900; }
.step-row { display: flex; align-items: flex-start; gap: 17rpx; margin-bottom: 22rpx; }
.step-row:last-child { margin-bottom: 0; }
.step-number { width: 46rpx; height: 46rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 15rpx; color: #fff; background: linear-gradient(135deg, #54bd97, #25a974); font-size: 23rpx; font-weight: 900; }
.step-text { flex: 1; min-width: 0; padding-top: 2rpx; color: var(--ink-2); font-size: 26rpx; line-height: 1.72; }

.notice-card { background: linear-gradient(155deg, #fff, #fff9ed); }
.note-row { display: flex; align-items: flex-start; gap: 14rpx; margin-top: 15rpx; }
.note-dot { width: 12rpx; height: 12rpx; margin-top: 15rpx; flex-shrink: 0; border-radius: 50%; background: #e18a2c; }
.note-text,
.no-note { flex: 1; color: var(--ink-2); font-size: 25rpx; line-height: 1.68; }
.source-note { padding: 34rpx 8rpx 0; text-align: center; color: #a0a7b3; font-size: 20rpx; }

.error { margin-top: 80rpx; padding: 56rpx 30rpx; text-align: center; }
.error-mark { width: 88rpx; height: 88rpx; margin: 0 auto 20rpx; display: flex; align-items: center; justify-content: center; border-radius: 28rpx; color: var(--danger); background: #fff0f0; font-size: 46rpx; font-weight: 900; }
.error-title { color: var(--ink); font-size: 34rpx; font-weight: 900; }
.error-copy { margin: 12rpx 0 28rpx; color: var(--muted); font-size: 24rpx; line-height: 1.6; }
