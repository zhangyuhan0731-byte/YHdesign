.cooking-page {
  position: fixed;
  inset: 0;
  display: flex;
  flex-direction: column;
  color: #fff;
  background:
    radial-gradient(circle at 80% -10%, rgba(82, 180, 225, .35), transparent 55%),
    radial-gradient(circle at 0% 100%, rgba(37, 169, 116, .25), transparent 50%),
    linear-gradient(160deg, #0e1a2b 0%, #16243a 55%, #0a1422 100%);
}

/* ============ 顶部 ============ */
.ck-top { padding: 40rpx 32rpx 24rpx; }
.ck-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.ck-exit {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, .1);
  border: 1rpx solid rgba(255, 255, 255, .16);
  transition: transform .15s ease, background .2s ease;
}
.ck-exit:active { transform: scale(.92); background: rgba(255, 255, 255, .18); }
.ck-exit .ic { width: 30rpx; height: 30rpx; }

.ck-recipe-name {
  flex: 1;
  min-width: 0;
  color: rgba(255, 255, 255, .85);
  font-size: 28rpx;
  font-weight: 800;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ck-top-spacer { width: 64rpx; height: 64rpx; flex-shrink: 0; }

.ck-progress-text {
  margin-bottom: 12rpx;
  color: rgba(255, 255, 255, .7);
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.ck-progress-bar {
  width: 100%;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .12);
  overflow: hidden;
}
.ck-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #52b4e1, #25a974);
  box-shadow: 0 0 18rpx rgba(82, 180, 225, .55);
  transition: width .3s ease;
}

/* ============ 中间内容 ============ */
.ck-content {
  flex: 1;
  overflow-y: auto;
  padding: 32rpx 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.ck-step-card {
  padding: 56rpx 36rpx 56rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, .06);
  border: 1rpx solid rgba(255, 255, 255, .1);
  box-shadow: 0 24rpx 48rpx rgba(0, 0, 0, .25);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.ck-step-num {
  width: 108rpx;
  height: 108rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #52b4e1, #2d7dd2);
  font-size: 50rpx;
  font-weight: 900;
  margin-bottom: 36rpx;
  box-shadow: 0 14rpx 32rpx rgba(45, 125, 210, .42);
}
.ck-step-text {
  color: #fff;
  font-size: 36rpx;
  line-height: 1.72;
  font-weight: 700;
  letter-spacing: .5rpx;
}

/* ============ 计时器 ============ */
.ck-timer-card {
  padding: 40rpx 32rpx 36rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, .06);
  border: 1rpx solid rgba(255, 255, 255, .1);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.ck-timer-ring {
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle, rgba(255, 255, 255, .08) 60%, transparent 62%),
    conic-gradient(#ffb547 var(--ring, 0deg), rgba(255, 255, 255, .08) var(--ring, 0deg));
  box-shadow: 0 14rpx 36rpx rgba(255, 181, 71, .22);
  transition: background .3s ease;
}
.ck-timer-ring-inner { display: flex; flex-direction: column; align-items: center; }
.ck-timer-time {
  font-size: 110rpx;
  line-height: 1;
  font-weight: 900;
  color: #fff;
  font-variant-numeric: tabular-nums;
  letter-spacing: 4rpx;
}
.ck-timer-time.finished {
  color: #ffd777;
  font-size: 70rpx;
  letter-spacing: 2rpx;
}
.ck-timer-label {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, .65);
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.ck-timer-bar {
  width: 100%;
  height: 6rpx;
  margin-top: 30rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .1);
  overflow: hidden;
}
.ck-timer-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #ffd777, #ffb547);
  transition: width 1s linear;
}

.ck-timer-actions {
  width: 100%;
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}
.ck-timer-btn {
  flex: 1;
  margin: 0;
  padding: 0;
  border: 0;
  height: 96rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 96rpx;
}
.ck-timer-btn::after { border: 0; }
.ck-timer-btn.primary {
  color: #0e1a2b;
  background: linear-gradient(135deg, #ffd777, #ffb547);
  box-shadow: 0 12rpx 26rpx rgba(255, 181, 71, .38);
}
.ck-timer-btn.primary:active { transform: scale(.97); box-shadow: 0 6rpx 14rpx rgba(255, 181, 71, .28); }
.ck-timer-btn.primary.is-pause {
  color: #fff;
  background: rgba(255, 255, 255, .14);
  border: 1rpx solid rgba(255, 255, 255, .24);
  box-shadow: none;
}
.ck-timer-btn.ghost {
  flex: 0 0 180rpx;
  color: rgba(255, 255, 255, .85);
  background: rgba(255, 255, 255, .08);
  border: 1rpx solid rgba(255, 255, 255, .18);
}
.ck-timer-btn.ghost:active { background: rgba(255, 255, 255, .16); }

/* 无计时提示 */
.ck-tip {
  padding: 28rpx 32rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, .04);
  border: 1rpx dashed rgba(255, 255, 255, .14);
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.ck-tip-icon { font-size: 36rpx; }
.ck-tip-text {
  flex: 1;
  color: rgba(255, 255, 255, .65);
  font-size: 25rpx;
  line-height: 1.6;
}

/* ============ 底部 ============ */
.ck-bottom {
  padding: 24rpx 32rpx 48rpx;
  display: flex;
  gap: 20rpx;
  background: rgba(0, 0, 0, .25);
  border-top: 1rpx solid rgba(255, 255, 255, .06);
}
.ck-nav-btn {
  flex: 1;
  margin: 0;
  padding: 0;
  border: 0;
  height: 110rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 110rpx;
}
.ck-nav-btn::after { border: 0; }
.ck-nav-btn:active { transform: scale(.98); }

.ck-nav-btn.prev {
  color: #fff;
  background: rgba(255, 255, 255, .08);
  border: 1rpx solid rgba(255, 255, 255, .2);
}
.ck-nav-btn.prev.disabled {
  color: rgba(255, 255, 255, .3);
  background: rgba(255, 255, 255, .03);
  border-color: rgba(255, 255, 255, .08);
}
.ck-nav-btn.prev.disabled:active { transform: none; }

.ck-nav-btn.next {
  color: #fff;
  background: linear-gradient(135deg, #52b4e1, #2d7dd2);
  box-shadow: 0 16rpx 30rpx rgba(45, 125, 210, .42);
}
.ck-nav-btn.next.finish {
  background: linear-gradient(135deg, #54bd97, #25a974);
  box-shadow: 0 16rpx 30rpx rgba(37, 169, 116, .42);
}